  m_Script: {fileID: 11500000, guid: 12e3beff4a79fc940bd65cc18992c5bc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UI_PlatformPromptsView
  _consentModal: {fileID: 5680354755818110087}
  _restoredTitle: "\uC54C\uB9BC"
  _restoredBody: "\uAD6C\uAE00 \uACC4\uC815\uC758 \uC9C4\uD589 \uC0C1\uD669\uC744
    \uBD88\uB7EC\uC654\uC2B5\uB2C8\uB2E4."
  _linkedTitle: "\uC54C\uB9BC"
  _linkedBody: "\uAD6C\uAE00 \uACC4\uC815\uACFC \uC5F0\uB3D9\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\n\uC9C4\uD589
    \uC0C1\uD669\uC774 \uD074\uB77C\uC6B0\uB4DC\uC5D0 \uC800\uC7A5\uB429\uB2C8\uB2E4."
  _confirm: "\uD655\uC778"
  _conflictTitle: "\uC774\uC5B4\uC11C \uD560 \uAE30\uB85D \uC120\uD0DD"
  _conflictBody: "\uC774 \uAE30\uAE30\uC640 \uAD6C\uAE00 \uACC4\uC815\uC5D0 \uC11C\uB85C
    \uB2E4\uB978 \uC9C4\uD589 \uAE30\uB85D\uC774 \uC788\uC2B5\uB2C8\uB2E4.{0}{1}"
  _deviceLine: "\n\uC774 \uAE30\uAE30: {0}\uC2A4\uD14C\uC774\uC9C0 \uD074\uB9AC\uC5B4,
    \uBCC4 {1}\uAC1C"
  _googleLine: "\n\uAD6C\uAE00 \uACC4\uC815: {0}\uC2A4\uD14C\uC774\uC9C0 \uD074\uB9AC\uC5B4,
    \uBCC4 {1}\uAC1C"
  _chooseGoogle: "\uAD6C\uAE00 \uACC4\uC815 \uAE30\uB85D"
  _chooseDevice: "\uC774 \uAE30\uAE30 \uAE30\uB85D"
  _updateRequiredTitle: "\uC5C5\uB370\uC774\uD2B8\uAC00 \uD544\uC694\uD569\uB2C8\uB2E4"
  _updateRequiredBody: "\uC0C8 \uBC84\uC804\uC774 \uB098\uC654\uC2B5\uB2C8\uB2E4.
    \uC2A4\uD1A0\uC5B4\uC5D0\uC11C \uCD5C\uC2E0 \uBC84\uC804\uC73C\uB85C \uC5C5\uB370\uC774\uD2B8\uD55C
    \uB4A4 \uB2E4\uC2DC \uC2E4\uD589\uD574 \uC8FC\uC2ED\uC2DC\uC624."
  _updateAvailableTitle: "\uC0C8 \uBC84\uC804\uC774 \uC788\uC2B5\uB2C8\uB2E4"
  _updateAvailableBody: "\uCD5C\uC2E0 \uBC84\uC804\uC73C\uB85C \uC5C5\uB370\uC774\uD2B8\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  _update: "\uC5C5\uB370\uC774\uD2B8"
  _later: "\uB098\uC911\uC5D0"
